{
    "name": "roadrunner-php/app-logger",
    "type": "library",
    "description": "Send log messages to RoadRunner",
    "license": "MIT",
    "authors": [
        {
            "name": "Kirill Astakhov (kastahov)",
            "email": "kirill.astakhov@spiralscout.com"
        },
        {
            "name": "RoadRunner Community",
            "homepage": "https://github.com/spiral/roadrunner/graphs/contributors"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "roadrunner-php/roadrunner-api-dto": "^1.18 || ^2.0",
        "spiral/goridge": "^4.3",
        "spiral/roadrunner": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "RoadRunner\\Logger\\": "src"
        }
    },
    "require-dev": {
        "mockery/mockery": "^1.5",
        "spiral/code-style": "^2.3.1",
        "testo/bridge-mockery": "^0.1.2",
        "testo/testo": "^0.10.55",
        "vimeo/psalm": "^6 || ^7"
    },
    "autoload-dev": {
        "psr-4": {
            "RoadRunner\\Logger\\Tests\\": "tests"
        }
    },
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff",
        "cs:fix": "php-cs-fixer fix -v",
        "test": "testo",
        "psalm": "psalm --no-cache"
    },
    "config": {
        "sort-packages": true,
        "audit": {
            "ignore": {
                "GHSA-g9pc-8g42-g6vq": "False positive: the range < 2025.1.0 also matches RoadRunner 3.x, which is not affected"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
